{
  "name": "commonwell",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "oxlint .",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:api": "node tests/api.integration.mjs",
    "db:init": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js d1 execute DB --local --config dist/server/wrangler.json --persist-to .wrangler/state --file drizzle/0000_acoustic_black_panther.sql",
    "test:lint": "node --test tests/lint.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.2",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.18.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "json-rpc-2.0": "1.8.1",
    "raw-body": "4.0.0",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vinext": "1.4.4",
    "vite": "8.3.5",
    "wrangler": "4.157.0",
    "esbuild": "0.28.2",
    "oxlint": "1.91.0"
  },
  "type": "module",
  "description": "A privacy-conscious membership app for self-reported tax contributions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intelliot/commonwell.git"
  },
  "bugs": {
    "url": "https://github.com/intelliot/commonwell/issues"
  },
  "overrides": {
    "fflate": "0.8.3",
    "esbuild": "$esbuild"
  }
}
